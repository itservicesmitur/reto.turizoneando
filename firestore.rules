rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is an Admin
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'Admin';
    }

    // Players — client can create/update their own profile fields; sensitive fields locked to Functions/Admins.
    match /players/{playerId} {
      allow read:   if (request.auth != null && request.auth.uid == playerId) || isAdmin();
      allow create: if request.auth != null && request.auth.uid == playerId &&
                        (!('score' in request.resource.data) || request.resource.data.score == 0) &&
                        (!('banned' in request.resource.data) || request.resource.data.banned == false);
      allow update: if (request.auth != null && request.auth.uid == playerId &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['score', 'banned'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // Participants — read own document only. Write is Functions or Admins.
    match /participants/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Stops — authenticated users can read active stops. Admins can read and write all.
    match /stops/{stopId} {
      allow read: if (request.auth != null && resource.data.active == true) || isAdmin();
      allow write: if isAdmin();
    }

    // Questions — never exposed directly to the client. Admins can read and write all.
    match /questions/{questionId} {
      allow read, write: if isAdmin();
    }

    // Prizes — read by authenticated users, write by Admins.
    match /prizes/{prizeId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Prize codes — Functions or Admins only.
    match /prizeCodes/{codeId} {
      allow read, write: if isAdmin();
    }

    // Sessions — write-only by Cloud Functions or Admins.
    match /sessions/{sessionId} {
      allow read, write: if isAdmin();
    }

    // Seasons — read by authenticated users, write by Admins.
    match /seasons/{seasonId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();

      match /stages/{stageId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
      }

      match /prizes/{prizeId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
      }
    }
  }
}
