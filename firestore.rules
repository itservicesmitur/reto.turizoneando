rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is an Admin
    function isAdmin() {
      return request.auth != null && (request.auth.token.role == 'Admin' || request.auth.token.role == 'admin');
    }

    // Helper function to check if the user is a Provider
    function isProvider() {
      return request.auth != null && request.auth.token.role == 'provider';
    }

    // Helper function to check if the provider owns the local
    function isProviderOf(localId) {
      return isProvider() && request.auth.token.localId == localId;
    }

    // Collection group rule required for collectionGroup('attempts') queries (live feed, etc.)
    match /{path=**}/attempts/{attemptId} {
      allow read: if isAdmin();
    }

    // Players — client can create/update their own profile fields; sensitive fields locked to Functions/Admins.
    match /players/{playerId} {
      allow read:   if (request.auth != null && request.auth.uid == playerId) || isAdmin();
      allow create: if request.auth != null && request.auth.uid == playerId &&
                        (!('score' in request.resource.data) || request.resource.data.score == 0) &&
                        (!('banned' in request.resource.data) || request.resource.data.banned == false);
      allow update: if (request.auth != null && request.auth.uid == playerId &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['score', 'banned'])) || isAdmin();
      allow delete: if isAdmin();

      // Attempts — written only by Cloud Functions (admin SDK); readable by owner and admins
      match /attempts/{attemptId} {
        allow read: if (request.auth != null && request.auth.uid == playerId) || isAdmin();
        allow write: if false; // only via registerAttempt Cloud Function (admin SDK)
      }
    }

    // Participants — read own document only. Write is Functions or Admins.
    match /participants/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Stops — authenticated users can read active stops. Admins can read and write all.
    match /stops/{stopId} {
      allow read: if (request.auth != null && resource.data.active == true) || isAdmin();
      allow write: if isAdmin();
    }

    // Questions — never exposed directly to the client. Admins can read and write all.
    match /questions/{questionId} {
      allow read, write: if isAdmin();
    }

    // Prizes — read by authenticated users, write by Admins.
    match /prizes/{prizeId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Prize codes — Admins can read/write all. Providers can read codes for their local only.
    // Players can read their own codes. Validation (claiming) is done via Cloud Function.
    match /prizeCodes/{codeId} {
      allow read: if isAdmin()
                  || (isProvider() && resource.data.localId == request.auth.token.localId)
                  || (request.auth != null && resource.data.playerId == request.auth.uid);
      allow write: if isAdmin();
    }

    // Locals — authenticated users can read; Admins can write.
    match /locals/{localId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Sessions — write-only by Cloud Functions or Admins.
    match /sessions/{sessionId} {
      allow read, write: if isAdmin();
    }

    // Seasons — read by authenticated users, write by Admins.
    match /seasons/{seasonId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();

      match /stages/{stageId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
      }

      match /prizes/{prizeId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
      }
    }
  }
}
