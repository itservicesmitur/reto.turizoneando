rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper: usuario autenticado con rol Admin (funciona en todos los ambientes)
    function isAdmin() {
      return request.auth != null && request.auth.token.role.lower() == 'admin';
    }

    // Helper: usuario autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Narración de audio — lectores autenticados, escritura solo Admin
    match /narrations/{stopId}/{file} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Imágenes de paradas — lectores autenticados, escritura solo Admin
    match /stops/{file} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Imágenes de premios — lectores autenticados, escritura solo Admin
    match /prizes/{file} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Fotos de perfil de administradores — lectores autenticados, escritura solo Admin
    match /admins/{file} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Imágenes de locales — lectores autenticados, escritura solo Admin
    match /locals/{file} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
