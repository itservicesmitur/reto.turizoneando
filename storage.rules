rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper function to check if the user is an Admin
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'Admin';
    }

    // Narration audio files — any authenticated user can read.
    // Write is handled by admin SDK or Admin users.
    match /narrations/{stopId}/{file} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Stop images — read by authenticated users, written by Admin users.
    match /stops/{file} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Prize images — read by authenticated users, written by Admin users.
    match /prizes/{file} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
